# Copiar como back/.env. Este archivo de ejemplo no contiene secretos válidos.
# La API busca .env desde su carpeta hacia la raíz; back/.env queda fuera de Git.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=jardin_inscripciones;Username=postgres;Password=Patoasado01
# Generar un valor aleatorio de al menos 32 caracteres; no usar este marcador.
Jwt__ClaveSecreta=COMPLETAR_LOCALMENTE
# Inicialización del Root: completar solo si se va a crear por primera vez.
UsuarioRoot__Correo=admin@jardin.local
UsuarioRoot__Clave=COMPLETAR_LOCALMENTE
